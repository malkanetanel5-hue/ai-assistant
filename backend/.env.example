# Copy this file to .env in this directory and fill in real values.
# On Railway / Render: set these as environment variables in the dashboard.
# NEVER commit the real .env file.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google OAuth 2.0 (Desktop app credentials) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloud deployment ──────────────────────────────────────────────────────────
# Your full public URL, no trailing slash.
# Railway sets this automatically once you enable a public domain.
# Example: https://ai-assistant-production.up.railway.app
APP_URL=

# Token persistence across container restarts (Railway / Render / Fly.io).
# Leave empty on first deploy. After completing OAuth:
#   1. Visit https://your-app.railway.app/auth/token-export
#   2. Copy the "value" field
#   3. Paste it here and redeploy.
GOOGLE_TOKEN_JSON=

# ── Telegram (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── App config ────────────────────────────────────────────────────────────────
# Set to "production" on cloud deployments to hide API docs
APP_ENV=development
LOG_LEVEL=info
