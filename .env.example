# Copy this file to backend/.env and fill in your values.
# Never commit the real .env file.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google OAuth 2.0 (Desktop app credentials) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.modify

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
LOG_LEVEL=info
